# Local development. Copy this file to .env (gitignored).
# The app loads .env on startup and leaves variables that are already
# set in the environment alone. Production sets those directly with
# `dokku config:set` and does not need this file.

# Defaults used when these are unset:
# ADDR=:8080
# DB_PATH=data/djm.db
# ENV=dev
# BASE_URL=http://localhost:8080

# Email. Without SMTP_HOST, emails (including sign-in links) are printed to the
# server log instead of being sent. Production uses Amazon SES SMTP credentials.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=DJMagic <noreply@djmagic.io>

# Cloudflare Turnstile. Development uses Cloudflare's always-pass test keys
# when both are unset. Production requires real keys.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Production sets TRUSTED_IP_HEADER=Fly-Client-IP because Fly Proxy is the
# trusted public ingress. Leave it unset in development.
# TRUSTED_IP_HEADER=

# Production only, read by Litestream in the container (not by the app yet):
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
