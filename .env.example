# Local development. Copy this file to .env (gitignored).
# The app loads .env on startup and leaves variables that are already
# set in the environment alone. Production sets those directly with
# `dokku config:set` and does not need this file.

# make dev and make run set these before startup, and this file cannot
# replace a variable that is already set:
#   ADDR=:8200
#   PORT=8200
#   BASE_URL=http://localhost:8200
#
# Defaults used when these are unset. The container leaves ADDR and PORT
# unset and listens on :8080. Do not set PORT here for local Docker.
# ADDR=:8080
# DB_PATH=data/djm.db
# ENV=dev
# BASE_URL=http://localhost:8080
#
# Search indexing. Ignored unless ENV=prod. Leave unset for local
# development and for staging. Set true only when BASE_URL is the public
# origin that should appear in search results.
# ALLOW_INDEXING=

# Song catalogs. Uploaded CSVs and built catalogs go in the blob store (a local
# directory until Tigris arrives); the cache holds built catalogs for searching
# and can be deleted at any time.
# BLOB_DIR=data/blobs
# CATALOG_CACHE_DIR=data/catalogs
# CATALOG_CACHE_MAX_BYTES=10737418240

# Email. Development uses the console backend unless you opt in.
# The console backend records the recipient and subject. It does not send
# mail, and it never logs the message body. Production uses SMTP and refuses
# to start unless SMTP_HOST is set. SMTP_USER and SMTP_PASS may be empty when
# the relay does not require them.
#
# SMTP settings on their own do not send mail in development. Startup fails
# if SMTP_HOST is set, or MAIL_BACKEND=smtp, unless DEV_ALLOW_SMTP is the
# exact string true. Set that flag together with the SMTP settings to send,
# including to MailHog (SMTP_HOST=localhost, SMTP_PORT=1025, inbox at
# http://localhost:8025).
#
# MAIL_BACKEND=console forces the console backend even when SMTP settings
# and DEV_ALLOW_SMTP are present. Named agent servers set MAIL_BACKEND=console,
# DEV_ALLOW_SMTP=false, and empty SMTP credentials themselves. A value in
# this file cannot override that. Leave MAIL_BACKEND unset in production.
# Production rejects DEV_ALLOW_SMTP and rejects MAIL_BACKEND=console.
# MAIL_BACKEND=
# DEV_ALLOW_SMTP=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=DJMagic <noreply@djmagic.io>

# Local development only. When this is the exact string true, ENV is dev, and
# SMTP_HOST is empty, the check-your-email page shows the sign-in link.
# The console backend does not print that link. Never set this in production.
# Production rejects it even if SMTP is configured.
# DEV_SHOW_MAGIC_LINK=

# Cloudflare Turnstile. Development uses Cloudflare's always-pass test keys
# when both are unset. Production requires real keys.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Production sets TRUSTED_IP_HEADER=Fly-Client-IP because Fly Proxy is the
# trusted public ingress. Leave it unset in development.
# TRUSTED_IP_HEADER=

# Production only, read by Litestream in the container (not by the app yet):
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
